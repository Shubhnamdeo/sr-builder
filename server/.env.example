# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sr_builder?retryWrites=true&w=majority
